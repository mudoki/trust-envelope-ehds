# Trust Envelope instantiation for the EHDS secondary use scenario
# Companion material for "Trusted Data Exchanges Across Regulatory Boundaries:
# A Research Agenda for Personal Data Vault Interoperability" (IFIP Summer School 2026), Sec. 5.3.
#
# Core terms follow the Trust Envelope specification (living document, 14 October 2025),
# https://w3id.org/trustenvelope
# Terms under the ext: prefix are the extensions PROPOSED in Sec. 5.1 of the paper:
#   ext:rightsExercise (R2), ext:request (R4), ext:stage (R5),
#   plus the stage value ext:Evaluation and the duty action ext:honourRetraction (R6).
# Signature values are placeholders; the specification leaves the signature scheme open.

@prefix ex:      <https://example.org/> .
@prefix ext:     <https://github.com/mudoki/trust-envelope-ehds#> .
@prefix te:      <https://w3id.org/trustenvelope#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# The envelope released to the research institution
ex:envelope-42 a te:TrustEnvelope ;
    dcterms:issued  "2026-04-02T09:00:00Z"^^xsd:dateTime ;
    dpv:hasData     ex:alice-glucose-readings ;
    odrl:hasPolicy  ex:grant-88 ;
    te:provenance   ex:dataProvenance-42 , ex:policyProvenance-42 ;
    te:sign         ex:signedEnvelope-42 .

ex:dataProvenance-42 a te:DataProvenance ;
    dcterms:issued      "2026-04-02T09:00:00Z"^^xsd:dateTime ;
    te:sender           ex:vault-alice ;
    dpv:hasDataSubject  ex:alice ;
    ext:rightsExercise  ex:access-2026-03-11 ;
    te:sign             ex:signedDataProvenance-42 .

ex:policyProvenance-42 a te:PolicyProvenance ;
    dcterms:issued      "2026-04-02T09:00:00Z"^^xsd:dateTime ;
    te:recipient        ex:research-institution ;
    te:rightsHolder     ex:alice ;
    ext:request         ex:request-88 ;
    prov:wasDerivedFrom ex:permit-HDAB-2026-014 ;              # EHDS Art. 68
    te:sign             ex:signedPolicyProvenance-42 .

# What the institution asked for: broader than what it received
ex:request-88 a odrl:Request ;
    odrl:uid ex:request-88 ;
    odrl:permission [
        a               odrl:Permission ;
        odrl:assignee   ex:research-institution ;
        odrl:action     odrl:use ;
        odrl:target     ex:alice-glucose-readings ;
        odrl:constraint [
            a                 odrl:Constraint ;
            odrl:leftOperand  odrl:purpose ;
            odrl:operator     odrl:isA ;
            odrl:rightOperand dpv:ResearchAndDevelopment
        ]
    ] .


# What was actually granted, within the HDAB permit (all constraints must hold)
ex:grant-88 a odrl:Agreement ;
    odrl:uid ex:grant-88 ;
    odrl:permission [
        a               odrl:Permission ;
        odrl:assigner   ex:vault-alice ;
        odrl:assignee   ex:research-institution ;
        odrl:action     odrl:use ;
        odrl:target     ex:alice-glucose-readings ;
        ext:stage       ext:Evaluation ;                 # R5, proposed
        odrl:constraint [
            a                 odrl:Constraint ;
            odrl:leftOperand  odrl:purpose ;
            odrl:operator     odrl:eq ;
            odrl:rightOperand ex:glycaemic-instability-algorithm
        ] , [
            a                 odrl:Constraint ;
            odrl:leftOperand  odrl:dateTime ;
            odrl:operator     odrl:lteq ;
            odrl:rightOperand "2027-03-11"^^xsd:date
        ] ;
        odrl:duty [ a odrl:Duty ; odrl:action odrl:inform ] ,              # R6, notify
                  [ a odrl:Duty ; odrl:action ext:honourRetraction ]       # R6, proposed
    ] .

ex:glycaemic-instability-algorithm a dpv:Purpose ;
    skos:broader  dpv:ResearchAndDevelopment ;
    rdfs:comment  "Training, testing and evaluation of an algorithm flagging glycaemic instability, EHDS Art. 53(1)(e)(ii)."@en .

ext:Evaluation a skos:Concept ;
    skos:prefLabel "Evaluation"@en ;
    rdfs:comment   "Evaluation stage of the purpose 'training, testing and evaluation of algorithms', EHDS Art. 53(1)(e)(ii)."@en .


# Which right of access produced the vault-held copy
ex:access-2026-03-11 a dpv:RightExerciseActivity ;
    dcterms:date  "2026-03-11"^^xsd:date ;
    dpv:hasRight  eu-gdpr:A15 , ex:ehds-art-3 .

ex:ehds-art-3 rdfs:comment "Right of access to personal electronic health data, EHDS Art. 3."@en .

# The permit itself, as issued by the Health Data Access Body
ex:permit-HDAB-2026-014 a prov:Entity ;
    prov:wasAttributedTo ex:hdab-be ;
    dcterms:valid        "2027-03-11"^^xsd:date ;
    rdfs:comment         "Data permit issued under EHDS Art. 68."@en .

# Signatures (structure as in the spec's examples)
ex:signedEnvelope-42         rdfs:comment "Signature by ex:vault-alice over ex:envelope-42."@en .
ex:signedDataProvenance-42   rdfs:comment "Signature by ex:vault-alice over ex:dataProvenance-42 and the data."@en .
ex:signedPolicyProvenance-42 rdfs:comment "Signature by ex:vault-alice over ex:policyProvenance-42 and ex:grant-88."@en .
